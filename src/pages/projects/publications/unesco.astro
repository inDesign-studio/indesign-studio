---
import BackToTop from '../../../components/BackToTop.astro';
import CaseFacts from '../../../components/CaseFacts.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseIndex from '../../../components/CaseIndex.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import CasePagination from '../../../components/CasePagination.astro';
import CaseResults from '../../../components/CaseResults.astro';
import ProjectCta from '../../../components/ProjectCta.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const covers = [
	['/portfolio/unesco/appendix-1-cover.webp', 'Обложка приложения 1 к диагностическому анализу ЮНЕСКО'],
	['/portfolio/unesco/appendix-2-cover.webp', 'Обложка приложения 2 к диагностическому анализу ЮНЕСКО'],
	['/portfolio/unesco/appendix-3-cover.webp', 'Обложка приложения 3 к диагностическому анализу ЮНЕСКО'],
	['/portfolio/unesco/appendix-4-cover.webp', 'Обложка приложения 4 к диагностическому анализу ЮНЕСКО'],
];
const gallery = [
	['gallery-a1.webp', 'gallery-a2.webp', 'Приложение 1 · Данные о криосфере'],
	['gallery-b1.webp', 'gallery-b2.webp', 'Приложение 1 · Анализ состояния криосферы'],
	['gallery-c1.webp', 'gallery-c2.webp', 'Приложение 2 · Карты криосферы'],
	['gallery-d1.webp', 'gallery-d2.webp', 'Приложение 3 · Сценарии изменений'],
	['gallery-e1.webp', 'gallery-e2.webp', 'Приложение 4 · Индикаторы состояния'],
	['gallery-f1.webp', 'gallery-f2.webp', 'Приложение 4 · Рекомендации по криосфере'],
];
---

	<BaseLayout
		title="UNESCO — анализ криосферы Центральной Азии"
		description="UNESCO — дизайн и вёрстка диагностического анализа о криосфере Центральной Азии и четырёх тематических приложений."
	>
		<SiteHeader />

		<main>
			<CaseIndex
				backHref="/projects/publications"
				items={[
					{ id: 'case-task', label: 'Задача' },
					{ id: 'case-analysis', label: 'Анализ' },
					{ id: 'case-applications', label: 'Приложения' },
					{ id: 'case-result', label: 'Результат' },
					{ id: 'case-gallery', label: 'Галерея' },
				]}
			/>

			<section class="project-hero">
				<p class="eyebrow">Многостраничные издания · Научные данные</p>
				<div class="hero-row">
					<h1>ЮНЕСКО <span class="title-accent">Диагностический<br /> анализ о криосфере<br /> Центральной Азии</span></h1>
					<p class="summary">Диагностический анализ о состоянии криосферы Центральной Азии и четыре тематических приложения на русском и английском языках. Мы разработали общую структуру для научных данных, карт, сценариев и рекомендаций.</p>
				</div>
			</section>

			<figure class="cover-stage">
				<div class="cover cover-small"><ResponsiveImage src="/portfolio/unesco/appendix-1-cover.webp" alt="Обложка приложения 1 к анализу криосферы ЮНЕСКО" sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
				<div class="cover cover-main"><ResponsiveImage src="/portfolio/unesco/diagnostic-cover.webp" alt="Обложка диагностического анализа о криосфере Центральной Азии ЮНЕСКО" sizes="(max-width: 700px) 36vw, 28vw" loading="eager" fetchpriority="high" /></div>
				<div class="cover cover-small"><ResponsiveImage src="/portfolio/unesco/appendix-4-cover.webp" alt="Обложка приложения 4 к анализу криосферы ЮНЕСКО" sizes="(max-width: 700px) 32vw, 24vw" loading="eager" /></div>
			</figure>

			<section class="overview section-grid" id="case-task" data-case-section>
				<p class="section-label">01 / Задача</p>
				<div class="rich-text">
					<h2>Научные данные — в последовательной структуре.</h2>
					<p>Основной доклад и четыре приложения объединяют большой объём данных о состоянии криосферы Центральной Азии: аналитику, карты, графики, таблицы и рекомендации. Нужно было сохранить научную точность материалов и при этом сделать каждую страницу понятной для последовательного чтения.</p>
					<p>Мы разработали модульную сетку, типографическую иерархию и шаблоны для карт, графиков, таблиц и выводов. Общие правила объединяют диагностический анализ и четыре приложения.</p>
				</div>
			</section>

			<CaseFacts items={[
				['Клиент', 'ЮНЕСКО'],
				['Состав', 'Анализ о криосфере · 4 приложения'],
				['Языки', 'Русский · Английский'],
				['Работы', 'Дизайн · Вёрстка · Инфографика'],
			]} />

			<section class="showcase showcase-black" id="case-analysis" data-case-section>
				<div class="showcase-head"><span>02 / Диагностический анализ</span><h2>Данные задают<br />структуру.</h2><p>Ключевые показатели состояния криосферы вынесены на первый план, а длинные тексты разделены на короткие смысловые уровни. Графика помогает сопоставлять регионы, отслеживать изменения и быстро находить выводы.</p></div>
				<div class="spread-pair">
					<ResponsiveImage src="/portfolio/unesco/diagnostic-data-1.webp" alt="Разворот анализа криосферы ЮНЕСКО с графиками" sizes="(max-width: 700px) 50vw, 44vw" />
					<ResponsiveImage src="/portfolio/unesco/diagnostic-data-2.webp" alt="Продолжение разворота анализа криосферы ЮНЕСКО" sizes="(max-width: 700px) 50vw, 44vw" />
				</div>
			</section>

			<section class="data-section section-grid">
				<p class="section-label">03 / Аналитика</p>
				<div class="rich-text"><h2>Текст, таблицы и выводы — по уровням.</h2><p>Заголовки, выводы, таблицы и пояснения занимают заданные уровни на каждой полосе. Даже насыщенные аналитические страницы остаются удобными для последовательного чтения.</p></div>
			</section>
			<div class="spread-frame">
				<div class="spread-pair">
					<ResponsiveImage src="/portfolio/unesco/diagnostic-analysis-1.webp" alt="Аналитическая полоса доклада ЮНЕСКО о криосфере" sizes="(max-width: 700px) 50vw, 44vw" />
					<ResponsiveImage src="/portfolio/unesco/diagnostic-analysis-2.webp" alt="Аналитическая полоса доклада ЮНЕСКО о криосфере с таблицами" sizes="(max-width: 700px) 50vw, 44vw" />
				</div>
			</div>

			<section class="covers-section" id="case-applications" data-case-section>
				<div class="showcase-head"><span>04 / Серия приложений</span><h2>Четыре приложения.<br />Общие правила.</h2><p>Каждое приложение раскрывает отдельный аспект состояния криосферы. Обложки собраны по одной схеме и различаются композицией и акцентным цветом.</p></div>
				<div class="covers-grid">
					{covers.map(([src, alt]) => <ResponsiveImage src={src} alt={alt} sizes="(max-width: 700px) 50vw, 25vw" />)}
				</div>
			</section>

			<section class="maps-section">
				<div class="section-grid compact-grid"><p class="section-label">05 / Карты и графики</p><div class="rich-text"><h2>Изменения видны<br />в сравнении.</h2><p>Карты криосферы, графики изменений и цветовые шкалы собраны в повторяемые модули. Они помогают сопоставлять регионы, периоды наблюдений и сценарии изменений.</p></div></div>
				<div class="spread-frame spread-frame-white">
					<div class="spread-pair">
						<ResponsiveImage src="/portfolio/unesco/appendix-system-1.webp" alt="Разворот приложения ЮНЕСКО с картами и графиками криосферы" sizes="(max-width: 700px) 50vw, 44vw" />
						<ResponsiveImage src="/portfolio/unesco/appendix-system-2.webp" alt="Продолжение разворота приложения ЮНЕСКО о криосфере" sizes="(max-width: 700px) 50vw, 44vw" />
					</div>
				</div>
			</section>

			<section class="analytics-section">
				<div class="showcase-head"><span>06 / Инфографика</span><h2>Карты и диаграммы<br />объясняют данные.</h2><p>Карты, диаграммы и индикаторы помогают сравнивать регионы, показывать динамику и фиксировать выводы. Для каждого типа данных подобрана форма, которая остаётся читаемой и в печати, и в цифровой версии.</p></div>
				<div class="analytics-grid">
					<ResponsiveImage src="/portfolio/unesco/climate-map-1.webp" alt="Карта состояния криосферы Центральной Азии ЮНЕСКО" sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/unesco/climate-map-2.webp" alt="Аналитическая карта криосферы ЮНЕСКО" sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/unesco/indicators-1.webp" alt="Инфографика индикаторов состояния криосферы ЮНЕСКО" sizes="(max-width: 700px) 50vw, 25vw" />
					<ResponsiveImage src="/portfolio/unesco/indicators-2.webp" alt="Диаграммы и индикаторы криосферы ЮНЕСКО" sizes="(max-width: 700px) 50vw, 25vw" />
				</div>
			</section>

			<section class="closing-section section-grid" id="case-result" data-case-section>
				<p class="section-label">07 / Результат</p>
				<div>
					<div class="rich-text"><h2>Диагностический анализ и четыре приложения.</h2><p>Анализ и приложения подготовлены на русском и английском языках. Общие правила для научных текстов, карт и инфографики помогают сопоставлять данные о криосфере разных регионов и показывать сценарии её изменений.</p></div>
					<CaseResults items={[
						['1 + 4', 'диагностический анализ и приложения'],
						['2 версии', 'русский и английский языки'],
						['Криосфера', 'научные карты и сценарии изменений'],
					]} />
				</div>
			</section>

			<ProjectCta subject="дизайн и вёрстку научного анализа о криосфере и тематических приложений" />

			<CaseGallery
				label="08 / Галерея"
				title="Развороты анализа и приложений."
				items={gallery.map(([left, right, caption]) => ({
					caption,
					images: [
						{ src: `/portfolio/unesco/${left}`, alt: `${caption}, левая полоса` },
						{ src: `/portfolio/unesco/${right}`, alt: `${caption}, правая полоса` },
					],
				}))}
				variant="spread"
				lightboxId="case-gallery-lightbox"
			/>
			<CaseLightbox id="case-gallery-lightbox" variant="spread" label="Увеличенный разворот" />

			<CasePagination
				previous={{ href: '/projects/publications/kipd', label: 'КИОР / KIPD' }}
				next={{ href: '/projects/publications/iofs', label: 'ИОПБ / IOFS' }}
			/>
			<ProjectFooter />
		</main>
		<BackToTop />
	</BaseLayout>

<style>
	:root { color:#0b0b0b; }
	header { height:6rem; padding:0 clamp(1.25rem,4vw,4.5rem); display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); align-items:center; }
	.back { width:max-content; display:flex; align-items:center; gap:.7rem; font-size:var(--text-navigation); font-weight:750; text-decoration:none; }
	.back span { width:2.25rem; aspect-ratio:1; display:grid; place-items:center; border:1px solid #1113; border-radius:50%; transition:transform .2s ease; }
	.back:hover span { transform:translateX(-.25rem); }
	.brand { width:clamp(7.8rem,10vw,10rem); line-height:0; }
	.brand img { width:100%; height:auto; }
	.page-count { justify-self:end; color:#777; font-size:var(--text-caption); font-weight:750; line-height:var(--leading-caption); letter-spacing:var(--tracking-caption); text-transform:uppercase; }
	main { padding:0 clamp(1rem,3vw,3rem) clamp(2rem,5vw,5rem); }
	.project-hero,.section-grid,.data-section,.closing-section { width:min(100%,88rem); margin-inline:auto; }
	.project-hero { padding:clamp(4rem,8vw,8rem) 0 clamp(4rem,7vw,7rem); }
	.eyebrow,.section-label,.showcase-head>span { margin:0; color:var(--color-accent); font-size:var(--text-label); font-weight:800; line-height:var(--leading-label); letter-spacing:var(--tracking-label); text-transform:uppercase; }
	.hero-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(18rem,.38fr); gap:clamp(2rem,6vw,7rem); align-items:end; }
	.showcase-head { display:grid; grid-template-columns:minmax(0,1fr) minmax(18rem,.42fr); column-gap:clamp(2rem,6vw,7rem); row-gap:clamp(2rem,4vw,4rem); align-items:start; }
	header>*,.hero-row>*,.showcase-head>*,.cover-stage>*,.section-grid>*,.spread-pair>*,.covers-grid>*,.analytics-grid>* { min-width:0; }
	.showcase-head>span { grid-column:1/-1; }
	.showcase-head h2 { grid-column:1; min-width:0; }
	.showcase-head p { grid-column:2; min-width:0; margin:0; }
	h1 { margin:2rem 0 0; font-size:var(--text-display-lg); line-height:var(--leading-display-lg); letter-spacing:var(--tracking-display-lg); }
	h1 .title-accent { display:block; color:var(--color-accent); font-family:inherit; font-size:1em; font-style:normal; font-weight:inherit; line-height:inherit; letter-spacing:inherit; overflow-wrap:anywhere; }
	.summary { margin:0; color:#5d5d5d; font-size:var(--text-lead); line-height:var(--leading-lead); }
	.cover-stage { width:min(100%,88rem); height:clamp(34rem,64vw,63rem); margin:0 auto; padding:clamp(1.5rem,5vw,5rem); display:flex; align-items:center; justify-content:center; gap:clamp(.75rem,2.4vw,2.5rem); position:relative; overflow:hidden; background:#0b0b0b; border-radius:var(--radius-shell); }
	.cover-stage::before { content:""; position:absolute; width:min(65vw,58rem); aspect-ratio:1; border:1px solid #fff2; border-radius:50%; box-shadow:0 0 0 8rem #0000,0 0 0 calc(8rem + 1px) #fff1; }
	.cover { flex:0 1 24%; z-index:1; filter:drop-shadow(0 2rem 2.5rem #000a); }
	.cover-main { flex-basis:31%; z-index:2; transform:translateY(-2%); }
	.cover-small:first-of-type { transform:rotate(-7deg) translateY(5%); }
	.cover-small:last-of-type { transform:rotate(7deg) translateY(5%); }
	.cover img { width:100%; height:auto; display:block; border-radius:var(--radius-thumb); }
	.section-grid { padding:clamp(6rem,11vw,11rem) 0; display:grid; grid-template-columns:minmax(8rem,.28fr) minmax(0,1fr); gap:clamp(2rem,7vw,9rem); }
	.rich-text h2,.showcase-head h2 { margin:0; font-size:var(--text-display-section); line-height:var(--leading-display-section); letter-spacing:var(--tracking-display-section); }
	.rich-text p,.showcase-head p { max-width:48rem; margin:2rem 0 0; color:#666; font-size:var(--text-body-lg); line-height:var(--leading-body-lg); }
	.showcase,.covers-section,.analytics-section { width:min(100%,88rem); margin:clamp(6rem,10vw,10rem) auto 0; padding:clamp(2rem,5vw,5rem); border-radius:var(--radius-shell); overflow:hidden; }
	.showcase-black,.analytics-section { color:#fff; background:#0b0b0b; }
	.showcase-head p { color:#999; }
	.spread-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.35rem; overflow:hidden; }
	.showcase .spread-pair { width:min(90%,68rem); margin:clamp(4rem,8vw,8rem) auto 0; box-shadow:0 2rem 5rem #0009; }
	.spread-pair img { width:100%; height:auto; display:block; }
	.data-section { padding-bottom:clamp(3rem,6vw,6rem); }
	.spread-frame { width:min(100%,88rem); margin:0 auto; padding:clamp(1rem,4vw,4rem); background:#efefec; border-radius:var(--radius-shell); }
	.spread-frame .spread-pair { width:min(88%,68rem); margin:auto; box-shadow:0 2rem 5rem #0002; }
	.covers-section { color:#fff; background:#0b0b0b; }
	.covers-grid { width:min(100%,72rem); margin:clamp(4rem,8vw,8rem) auto 1rem; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(.75rem,2vw,2rem); align-items:center; }
	.covers-grid img { width:100%; height:auto; display:block; border-radius:var(--radius-thumb); box-shadow:0 1.5rem 3rem #000b; }
	.covers-grid img:nth-child(odd) { transform:translateY(5%); }
	.maps-section { width:min(100%,88rem); margin:auto; }
	.compact-grid { padding-bottom:clamp(3rem,6vw,6rem); }
	.spread-frame-white { background:#f5f5f2; }
	.analytics-grid { margin-top:clamp(4rem,8vw,8rem); display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(.5rem,1vw,1rem); align-items:start; }
	.analytics-grid img { width:100%; height:auto; display:block; box-shadow:0 1.2rem 3rem #000a; }
	.analytics-grid img:nth-child(even) { transform:translateY(7%); }
	.closing-section { padding-bottom:clamp(3rem,5vw,5rem); }
	@media (max-width:900px) {
		.hero-row,.showcase-head { grid-template-columns:minmax(0,1fr); gap:1.5rem; }
		.showcase-head>span,.showcase-head h2,.showcase-head p { grid-column:1; }
		.summary { max-width:38rem; }
		.covers-grid,.analytics-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
	}
	@media (max-width:620px) {
		header { height:4.75rem; padding:0 1rem; grid-template-columns:minmax(0,1fr); }
		.brand,.page-count { display:none; }
		main { padding-inline:1rem; }
		.project-hero { padding:3.5rem 0 3rem; }
		.eyebrow,.section-label,.showcase-head>span { overflow-wrap:anywhere; }
		h1 { max-width:100%; margin-top:1.5rem; }
		.summary { max-width:100%; overflow-wrap:anywhere; }
		.cover-stage { height:27rem; padding:1rem; gap:.5rem; }
		.cover { flex-basis:29%; }
		.cover-main { flex-basis:42%; }
		.section-grid { grid-template-columns:minmax(0,1fr); gap:1.5rem; padding:5rem 0; }
		.rich-text h2,.showcase-head h2 { overflow-wrap:anywhere; }
		.rich-text p,.showcase-head p { overflow-wrap:anywhere; }
		.showcase,.covers-section,.analytics-section,.spread-frame { padding:1rem; }
		.spread-pair { grid-template-columns:minmax(0,1fr); gap:.75rem; }
		.showcase .spread-pair,.spread-frame .spread-pair { width:100%; box-shadow:none; }
		.covers-grid,.analytics-grid { width:100%; gap:.75rem; }
		.covers-grid img,.analytics-grid img { transform:none !important; }
	}
	@media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto!important; transition-duration:.01ms!important; } }
	:focus-visible { outline:var(--focus-ring-width) solid var(--focus-ring-color); outline-offset:var(--focus-ring-offset); }
</style>
