---
import BackToTop from '../../../components/BackToTop.astro';
import CasePagination from '../../../components/CasePagination.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="UNESCO — обложка отчёта" description="Обложка отчёта ЮНЕСКО — работа InDesign Studio.">
	<SiteHeader />
	<main>
		<section class="project-hero">
			<a class="back" href="/projects/publications">← Все многостраничные издания</a>
			<p class="eyebrow">Дизайн обложки</p>
			<h1>ЮНЕСКО <span>Обложка отчёта</span></h1>
		</section>
		<figure class="cover-stage">
			<ResponsiveImage src="/portfolio/unesco/diagnostic-cover.webp" alt="Обложка отчёта ЮНЕСКО" sizes="(max-width: 700px) 75vw, 28rem" loading="eager" fetchpriority="high" />
		</figure>
		<CasePagination
			previous={{ href: '/projects/publications/kipd', label: 'КИОР / KIPD' }}
			next={{ href: '/projects/publications/iofs', label: 'ИОПБ / IOFS' }}
		/>
		<ProjectFooter />
	</main>
	<BackToTop />
</BaseLayout>

<style>
	main { padding:0 clamp(1rem,3vw,3rem) clamp(2rem,5vw,5rem); }
	.project-hero { width:min(100%,88rem); margin:auto; padding:clamp(2rem,5vw,5rem) 0; }
	.back { font-size:var(--text-navigation); font-weight:750; text-decoration:none; }
	.back:hover { color:var(--color-accent); }
	.eyebrow { margin:3rem 0 1.5rem; color:var(--color-accent); font-size:var(--text-label); font-weight:800; letter-spacing:var(--tracking-label); text-transform:uppercase; }
	h1 { margin:0; font-size:var(--text-display-lg); line-height:1.1; letter-spacing:var(--tracking-display-lg); }
	h1 span { display:block; color:var(--color-accent); }
	.cover-stage { width:min(100%,88rem); margin:0 auto; padding:clamp(2rem,5vw,5rem); display:grid; place-items:center; background:#0b0b0b; border-radius:var(--radius-shell); }
	.cover-stage img { display:block; width:min(100%,28rem); height:auto; border-radius:var(--radius-thumb); }
	:focus-visible { outline:var(--focus-ring-width) solid var(--focus-ring-color); outline-offset:var(--focus-ring-offset); }
</style>