---
import BackToTop from '../../../components/BackToTop.astro';
import CaseGallery from '../../../components/CaseGallery.astro';
import CaseIndex from '../../../components/CaseIndex.astro';
import CaseLightbox from '../../../components/CaseLightbox.astro';
import ProjectCta from '../../../components/ProjectCta.astro';
import ProjectFooter from '../../../components/ProjectFooter.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const filters = [
	{ id: 'all', label: 'Все работы' },
	{ id: 'research', label: 'Исследования' },
	{ id: 'reports', label: 'Отчёты' },
	{ id: 'social', label: 'Социальные данные' },
	{ id: 'science', label: 'Научные данные' },
	{ id: 'illustrative', label: 'Иллюстративная инфографика' },
];

const featuredNumbers = new Set([17, 32, 40, 41, 47, 59, 76, 83, 89]);
const illustrativeNumbers = new Set([6, 8, 9, 14, 15, 17, 19, 20, 21, 32, 40, 41, 42, 43, 44, 45, 46, 47, 59, 62, 63, 64]);
const curatedNumbers = [1, 2, 3, 4, 6, 8, 14, 20, 21, 22, 42, 43, 44, 45, 46, 62, 63, 64, 70, 72, 73, 82, 91, 95];
const curatedRank = new Map(curatedNumbers.map((number, index) => [number, index]));

const getGroup = (number: number) => {
	if (number <= 11) return 'Годовые отчёты и международная статистика';
	if (number <= 21) return 'Социальные исследования и правовые реформы';
	if (number <= 39) return 'Гражданские исследования';
	if (number <= 69) return 'Социально-демографические исследования';
	if (number <= 90) return 'Научные и климатические данные';
	return 'Оценка образовательных программ';
};

const getCategories = (number: number) => {
	const categories = [];
	if (number <= 11 || number === 22) categories.push('reports');
	if ((number >= 12 && number <= 39) || number >= 91) categories.push('research');
	if (number >= 12 && number <= 69) categories.push('social');
	if (number >= 70 && number <= 90) categories.push('science');
	if (number === 91) categories.push('processes');
	if (number === 4) categories.push('maps');
	if (illustrativeNumbers.has(number)) categories.push('illustrative');
	return categories;
};

const allImages = Array.from({ length: 101 }, (_, index) => {
	const number = index + 1;
	return {
		number,
		src: `/portfolio/infographics/graphic-${String(number).padStart(3, '0')}.webp`,
		group: getGroup(number),
		categories: getCategories(number),
	};
});

const galleryImages = allImages
	.filter(({ number }) => !featuredNumbers.has(number))
	.sort((a, b) => {
		const aRank = curatedRank.get(a.number);
		const bRank = curatedRank.get(b.number);
		if (aRank !== undefined && bRank !== undefined) return aRank - bRank;
		if (aRank !== undefined) return -1;
		if (bRank !== undefined) return 1;
		return a.number - b.number;
	});

const initialGalleryCount = 24;
---

	<BaseLayout
		title="Инфографика — InDesign Studio"
		description="Инфографика InDesign Studio: анализируем данные, формулируем вывод и показываем цифры в диаграммах, картах и схемах."
	>
		<SiteHeader />

		<main>
			<CaseIndex
				items={[
					{ id: 'case-approach', label: 'Подход' },
					{ id: 'case-examples', label: 'Примеры' },
					{ id: 'case-result', label: 'Результат' },
					{ id: 'case-gallery', label: 'Галерея' },
				]}
			/>

			<section class="project-hero">
				<p class="eyebrow">Аналитика · Дизайн данных · Инфографика</p>
				<div class="hero-row">
					<h1>Данные<br /><span class="title-accent">становятся историей.</span></h1>
					<p class="summary">Получаем таблицы, массивы цифр, результаты исследований и черновые схемы. Разбираемся в содержании, формулируем ключевой вывод и выбираем форму, которая сохраняет точность и контекст данных.</p>
				</div>
			</section>

			<section class="approach section-grid" id="case-approach" data-case-section>
				<p class="section-label">01 / Подход</p>
				<div class="rich-text">
					<h2>Сначала понимаем данные. Потом рисуем.</h2>
					<p>Мы не начинаем с выбора красивой диаграммы. Сначала проверяем структуру исходных данных, единицы измерения, связи, сравнимость показателей и контекст. Отделяем важное от второстепенного и формулируем вывод, который должен увидеть читатель.</p>
					<p>Чтобы сравнить значения, показать динамику, объяснить состав, географию или последовательность действий, нужны разные графические приёмы. Если исходный материал не складывается в историю, мы задаём вопросы, группируем данные, убираем повторы и задаём порядок чтения.</p>
			</div>
			</section>

			<dl class="process">
				<div><dt>01 / Анализ</dt><dd>Проверяем исходные данные и формулируем вывод</dd></div>
				<div><dt>02 / Сценарий</dt><dd>Выстраиваем последовательность чтения</dd></div>
				<div><dt>03 / Форма</dt><dd>Выбираем точный способ визуализации</dd></div>
				<div><dt>04 / Адаптация</dt><dd>Готовим для печати и цифровых носителей</dd></div>
			</dl>

			<section class="showcase showcase-dark">
				<div class="showcase-head">
					<p>02 / Смысл</p>
					<h2>Из массива цифр —<br />в точный вывод.</h2>
					<div>
						<p>Сравнение, порядок, масштаб и акцент работают вместе. Ключевой вывод виден сразу, а детали и исходные значения остаются доступными для проверки.</p>
						<p>Иллюстрации сохраняем рядом с данными, когда они помогают раскрыть тему и создают нужный эмоциональный контекст.</p>
					</div>
				</div>
				<div class="meaning-grid">
					<figure class="meaning-main"><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-017.webp" data-caption="Социальные исследования и правовые реформы"><ResponsiveImage src="/portfolio/infographics/graphic-017.webp" alt="Инфографика исследования с диаграммой и тематической иллюстрацией" sizes="(max-width: 700px) 100vw, 65vw" loading="eager" fetchpriority="high" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-032.webp" data-caption="Гражданские исследования"><ResponsiveImage src="/portfolio/infographics/graphic-032.webp" alt="Инфографика гражданского исследования с иллюстрацией" sizes="(max-width: 700px) 100vw, 33vw" /></button></figure>
				</div>
			</section>

			<section class="story-section" id="case-examples" data-case-section>
				<div class="section-grid compact-grid">
					<p class="section-label">03 / История</p>
					<div class="rich-text">
						<h2>Не украшаем данные. Объясняем их.</h2>
						<p>Хорошая инфографика не упрощает смысл — она упрощает путь к нему. Мы объединяем цифры, подписи, иллюстрации и графические метафоры в сценарий чтения, где каждый элемент отвечает на конкретный вопрос.</p>
					</div>
				</div>
				<div class="story-grid">
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-040.webp" data-caption="Социально-демографические исследования"><ResponsiveImage src="/portfolio/infographics/graphic-040.webp" alt="Инфографика социально-демографического исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-041.webp" data-caption="Социально-демографические исследования"><ResponsiveImage src="/portfolio/infographics/graphic-041.webp" alt="Инфографика об образовании" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-047.webp" data-caption="Социально-демографические исследования"><ResponsiveImage src="/portfolio/infographics/graphic-047.webp" alt="Инфографика уровня доходов" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-059.webp" data-caption="Социально-демографические исследования"><ResponsiveImage src="/portfolio/infographics/graphic-059.webp" alt="Иллюстративная инфографика исследования" sizes="(max-width: 700px) 50vw, 25vw" /></button></figure>
				</div>
			</section>

			<section class="science showcase-dark">
				<div class="showcase-head">
					<p>04 / Масштаб</p>
					<h2>От социологии<br />до климатических моделей.</h2>
					<div>
						<p>Работаем с исследованиями, годовыми отчётами, мониторингом, опросами и научными данными. Сохраняем точность показателей и подбираем формат для страницы издания, экрана или презентационного слайда.</p>
					</div>
				</div>
				<div class="science-grid">
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-076.webp" data-caption="Научные и климатические данные"><ResponsiveImage src="/portfolio/infographics/graphic-076.webp" alt="Научная инфографика с объёмной диаграммой" sizes="(max-width: 700px) 100vw, 33vw" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-083.webp" data-caption="Научные и климатические данные"><ResponsiveImage src="/portfolio/infographics/graphic-083.webp" alt="Тепловая карта научного исследования" sizes="(max-width: 700px) 100vw, 33vw" /></button></figure>
					<figure><button class="zoom-trigger" data-lightbox-target="case-gallery-lightbox" type="button" data-src="/portfolio/infographics/graphic-089.webp" data-caption="Научные и климатические данные"><ResponsiveImage src="/portfolio/infographics/graphic-089.webp" alt="Схема процесса в научном исследовании" sizes="(max-width: 700px) 100vw, 33vw" /></button></figure>
			</div>
			</section>

			<section class="statement section-grid" id="case-result" data-case-section>
				<p class="section-label">05 / Результат</p>
				<div>
					<h2>Данные, которые можно понять, сравнить и запомнить.</h2>
					<p>Берём на себя весь путь: от разбора исходных таблиц и выбора способа подачи до дизайна, вёрстки и подготовки файлов к публикации. В результате получается согласованный комплект диаграмм, карт и схем.</p>
				</div>
			</section>

			<ProjectCta subject="инфографику и визуализацию данных" />

			<CaseGallery
				label="06 / Галерея"
				title="92 работы о данных."
				description="Сначала показаны 24 сильных и разнообразных примера. Темы доступны в фильтрах, а остальные работы загружаются порциями по кнопке «Показать ещё»."
				items={galleryImages.map(({ number, src, group, categories }, index) => ({
					caption: group,
					number: String(number).padStart(3, '0'),
					categories,
					hidden: index >= initialGalleryCount,
					images: [{ src, alt: `${group}: пример инфографики ${number}` }],
				}))}
				variant="numbered"
				lightboxId="case-gallery-lightbox"
			>
				<div slot="controls" class="tags" aria-label="Фильтры галереи">
					{filters.map(({ id, label }) => (
						<button
							class:list={['format-filter', { active: id === 'all' }]}
							type="button"
							data-filter={id}
							aria-pressed={id === 'all' ? 'true' : 'false'}
						>
							{label}
						</button>
					))}
				</div>
				<div slot="toolbar" class="gallery-toolbar">
					<p class="gallery-status" aria-live="polite">Показано 24 из 92</p>
					<button class="gallery-reset" type="button" hidden>Сбросить фильтр</button>
				</div>
				<div slot="actions" class="gallery-actions">
					<button class="gallery-more" type="button">Показать ещё</button>
				</div>
			</CaseGallery>

			<CaseLightbox id="case-gallery-lightbox" variant="single" label="Увеличенное изображение инфографики" />

			<ProjectFooter />
		</main>

		<BackToTop />

		<script>
			const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('.format-filter')];
			const galleryItems = [...document.querySelectorAll<HTMLElement>('[data-gallery-item]')];
			const galleryStatus = document.querySelector<HTMLElement>('.gallery-status');
			const galleryMore = document.querySelector<HTMLButtonElement>('.gallery-more');
			const galleryReset = document.querySelector<HTMLButtonElement>('.gallery-reset');
			const gallery = document.querySelector<HTMLElement>('#case-gallery');
			const pageSize = 24;
			let activeFilter = 'all';
			let visibleCount = pageSize;

			const updateGallery = () => {
				const matchingItems = galleryItems.filter((item) =>
					activeFilter === 'all' || item.dataset.categories?.split(' ').includes(activeFilter)
				);

				galleryItems.forEach((item) => {
					const matchingIndex = matchingItems.indexOf(item);
					item.hidden = matchingIndex === -1 || matchingIndex >= visibleCount;
				});

				const shownCount = Math.min(visibleCount, matchingItems.length);
				if (galleryStatus) galleryStatus.textContent = `Показано ${shownCount} из ${matchingItems.length}`;
				if (galleryMore) galleryMore.hidden = shownCount >= matchingItems.length;
				if (galleryReset) galleryReset.hidden = activeFilter === 'all';
			};

			const setFilter = (filter: string, scrollToGallery = false) => {
				activeFilter = filter;
				visibleCount = pageSize;
				filterButtons.forEach((button) => {
					const isActive = button.dataset.filter === activeFilter;
					button.classList.toggle('active', isActive);
					button.setAttribute('aria-pressed', String(isActive));
				});
				updateGallery();
				if (scrollToGallery) gallery?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			};

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => setFilter(button.dataset.filter ?? 'all'));
			});
			galleryMore?.addEventListener('click', () => {
				visibleCount += pageSize;
				updateGallery();
			});
			galleryReset?.addEventListener('click', () => setFilter('all'));
			updateGallery();

		</script>
	</BaseLayout>

<style>
	:root { color: #0b0b0b; }
	header { height: 6rem; padding: 0 clamp(1.25rem,4vw,4.5rem); display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; }
	.back { display: flex; align-items: center; gap: .7rem; width: max-content; font-size: var(--text-navigation); font-weight: 750; text-decoration: none; }
	.back span { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border: 1px solid #1113; border-radius: 50%; transition: transform .2s ease; }
	.back:hover span { transform: translateX(-.25rem); }
	.brand { width: clamp(7.8rem,10vw,10rem); line-height: 0; }
	.brand img { display: block; width: 100%; }
	.page-count { justify-self: end; color: #777; font-size: var(--text-caption); font-weight: 750; line-height: var(--leading-caption); letter-spacing: var(--tracking-caption); text-transform: uppercase; }
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.project-hero { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(4rem,8vw,7rem) 0 clamp(4rem,7vw,7rem); }
	.eyebrow,.section-label,.showcase-head > p { margin: 0; color: var(--color-accent); font-size: var(--text-label); font-weight: 800; line-height: var(--leading-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.hero-row { display: grid; grid-template-columns: minmax(0,1fr) minmax(20rem,.42fr); gap: 4rem; align-items: end; }
	header > *,.hero-row > *,.section-grid > *,.showcase-head > *,.process > *,.meaning-grid > *,.story-grid > *,.science-grid > *,.gallery-toolbar > * { min-width: 0; }
	h1 { margin: 0; max-width: 60rem; font-size: var(--text-display-lg); line-height: var(--leading-display-lg); letter-spacing: var(--tracking-display-lg); }
	h1 .title-accent { display:block; color:var(--color-accent); font-family:inherit; font-size:1em; font-style:normal; font-weight:inherit; line-height:inherit; letter-spacing:inherit; overflow-wrap:anywhere; }
	.summary { margin: 0; color: #565656; font-size: var(--text-lead); line-height: var(--leading-lead); }
	.section-grid { width: 100%; max-width: 82rem; margin: 0 auto; display: grid; grid-template-columns: minmax(10rem,.28fr) minmax(0,1fr); gap: clamp(2rem,7vw,8rem); }
	.approach { padding: 0 0 clamp(4rem,7vw,7rem); }
	.rich-text h2,.statement h2,.showcase-head h2 { margin: 0; font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	.rich-text p,.statement p { max-width: 52rem; margin: 1.7rem 0 0; color: #5a5a5a; font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.process { width: 100%; max-width: 82rem; margin: 0 auto clamp(7rem,12vw,12rem); display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border-top: 1px solid #1112; border-bottom: 1px solid #1112; }
	.process div { padding: 1.7rem 1.2rem; border-right: 1px solid #1112; }
	.process div:last-child { border-right: 0; }
	.process dt { color: var(--color-accent); font-size: var(--text-caption); font-weight: 800; line-height: var(--leading-caption); letter-spacing: var(--tracking-caption); text-transform: uppercase; }
	.process dd { margin: .8rem 0 0; font-size: .92rem; font-weight: 700; line-height: 1.4; }
	.showcase { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(2rem,4vw,4.5rem); border-radius: var(--radius-shell); }
	.showcase-dark { color: #fff; background: #0b0b0b; }
	.showcase-head { display: grid; grid-template-columns: minmax(0,.23fr) minmax(0,1fr) minmax(0,.54fr); gap: clamp(1.5rem,4vw,4.5rem); align-items: end; margin-bottom: clamp(3rem,6vw,6rem); }
	.showcase-head > div p { margin: 0; color: #b5b5b5; font-size: var(--text-body); line-height: var(--leading-body); }
	.showcase-head > div p + p { margin-top: 1rem; }
	.zoom-trigger { display: block; width: 100%; padding: 0; overflow: hidden; color: inherit; background: transparent; border: 0; cursor: zoom-in; }
	.zoom-trigger img { display: block; width: 100%; height: auto; transition: transform .35s ease; }
	.zoom-trigger:hover img { transform: scale(1.015); }
	.zoom-trigger:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.meaning-grid { width: min(86%,69rem); margin: 0 auto; display: grid; grid-template-columns: minmax(0,1.08fr) minmax(0,.92fr); gap: clamp(1rem,3vw,3rem); align-items: center; }
	.meaning-grid figure,.story-grid figure,.science-grid figure { margin: 0; }
	.meaning-grid figure { padding: clamp(.5rem,1.2vw,1rem); background: #fff; border-radius: var(--radius-thumb); box-shadow: 0 2rem 5rem #0008; }
	.meaning-grid figure:last-child { transform: translateY(3rem) rotate(2deg); }
	.story-section { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(8rem,13vw,13rem) 0; }
	.compact-grid { margin-bottom: clamp(3rem,6vw,6rem); }
	.story-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: clamp(.7rem,1.5vw,1.5rem); align-items: start; }
	.story-grid figure { padding: clamp(.45rem,1vw,.8rem); background: #fff; border: 1px solid #1112; border-radius: var(--radius-thumb); box-shadow: 0 1.5rem 3rem #00000010; }
	.story-grid figure:nth-child(even) { margin-top: 4rem; }
	.science { width: 100%; max-width: 88rem; margin: 0 auto; padding: clamp(2rem,4vw,4.5rem); border-radius: var(--radius-shell); }
	.science-grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.15fr) minmax(0,.95fr); gap: clamp(.8rem,2vw,2rem); align-items: center; }
	.science-grid figure { padding: clamp(.45rem,1vw,.8rem); background: #fff; border-radius: var(--radius-thumb); }
	.science-grid figure:nth-child(2) { transform: translateY(2rem); }
	.statement { padding: clamp(8rem,14vw,14rem) 0 clamp(3rem,5vw,5rem); }
	.statement h2 { max-width: 58rem; }
	.tags { max-width: 52rem; margin-top: 1.5rem; display: flex; flex-wrap: nowrap; gap: .45rem; }
	.format-filter { min-height: 2.75rem; padding: .55rem .75rem; color: #111; background: #fff; border: 1px solid #1113; border-radius: var(--radius-pill); font-size: .7rem; font-weight: 700; line-height: 1.2; white-space: nowrap; cursor: pointer; transition: color .2s ease, background .2s ease, border-color .2s ease; }
	.format-filter:hover { border-color: #111; }
