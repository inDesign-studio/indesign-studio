---
import ResponsiveImage from './ResponsiveImage.astro';

interface GalleryImage {
	src: string;
	alt: string;
	width?: number;
	height?: number;
}

interface GalleryItem {
	images: GalleryImage[];
	caption: string;
	number?: string;
	categories?: string[];
	hidden?: boolean;
}

interface Props {
	id?: string;
	label: string;
	title: string;
	description?: string;
	items: GalleryItem[];
	variant: 'spread' | 'pages' | 'numbered';
	lightboxId: string;
}

const { id = 'case-gallery', label, title, description, items, variant, lightboxId } = Astro.props;
const titleId = `${id}-title`;
const imageSizes = variant === 'spread'
	? '(max-width: 620px) 25vw, (max-width: 900px) 25vw, 17vw'
	: variant === 'numbered'
		? '(max-width: 620px) 50vw, (max-width: 900px) 33vw, 25vw'
		: '(max-width: 620px) 50vw, (max-width: 900px) 33vw, 20vw';
---

<section id={id} class:list={['case-gallery', `case-gallery-${variant}`]} data-case-section aria-labelledby={titleId}>
	<div class="case-gallery-head">
		<p class="case-gallery-label">{label}</p>
		<div>
			<h2 id={titleId}>{title}</h2>
			{description && <p class="case-gallery-description">{description}</p>}
			<slot name="controls" />
		</div>
	</div>

	<slot name="toolbar" />

	<div class="case-gallery-grid">
		{items.map(({ images, caption, number, categories, hidden }) => (
			<figure
				class="case-gallery-item"
				data-gallery-item={variant === 'numbered' ? '' : undefined}
				data-categories={categories?.join(' ')}
				hidden={hidden}
			>
				<button
					class="case-gallery-trigger"
					type="button"
					data-lightbox-target={lightboxId}
					data-caption={number ? `${caption} · ${number}` : caption}
					aria-label={`Увеличить: ${caption}`}
				>
					{images.map(({ src, alt }) => (
						<ResponsiveImage src={src} alt={alt} sizes={imageSizes} loading="lazy" />
					))}
				</button>
				<figcaption>
					<span>{caption}</span>
					{number && <b>{number}</b>}
				</figcaption>
			</figure>
		))}
	</div>

	<slot name="actions" />
</section>

<style>
	.case-gallery { width: 100%; max-width: 88rem; margin: 0 auto; padding-bottom: clamp(3rem,5vw,5rem); }
	.case-gallery-head { margin-bottom: clamp(3rem,6vw,6rem); display: grid; grid-template-columns: minmax(8rem,.28fr) minmax(0,1fr); gap: clamp(2rem,7vw,9rem); }
	.case-gallery-head > * { min-width: 0; }
	.case-gallery-label { margin: 0; color: var(--color-accent); font-size: var(--text-label); font-weight: 800; line-height: var(--leading-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.case-gallery h2 { margin: 0; font-size: var(--text-display-section); line-height: var(--leading-display-section); letter-spacing: var(--tracking-display-section); }
	.case-gallery-description { max-width: 48rem; margin: 1.5rem 0 0; color: #666; font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
	.case-gallery-grid { min-width: 0; }
	.case-gallery-item { min-width: 0; margin: 0; break-inside: avoid; }
	.case-gallery-item[hidden] { display: none; }
	.case-gallery-trigger { width: 100%; padding: .45rem; display: grid; color: inherit; background: #efefec; border: 1px solid rgba(17,17,17,.12); border-radius: var(--radius-thumb); overflow: hidden; cursor: zoom-in; transition: transform .25s ease, box-shadow .25s ease; }
	.case-gallery-trigger:hover { transform: translateY(-.25rem); box-shadow: 0 1.2rem 2.5rem rgba(0,0,0,.12); }
	.case-gallery-trigger:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.case-gallery-trigger img { display: block; width: 100%; height: auto; }
	.case-gallery-item figcaption { margin-top: .7rem; color: #666; font-size: var(--text-caption); font-weight: 750; letter-spacing: var(--tracking-caption); line-height: var(--leading-caption); text-transform: uppercase; }
	.case-gallery-item figcaption span { min-width: 0; overflow-wrap: anywhere; }

	.case-gallery-spread .case-gallery-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1.25rem,2vw,2rem); }
	.case-gallery-spread .case-gallery-trigger { aspect-ratio: 1.85; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .2rem; }
	.case-gallery-spread .case-gallery-trigger img { height: 100%; object-fit: contain; }

	.case-gallery-pages .case-gallery-grid,
	.case-gallery-numbered .case-gallery-grid { columns: 5; column-gap: clamp(.65rem,1.2vw,1.2rem); }
	.case-gallery-numbered .case-gallery-grid { columns: 4; }
	.case-gallery-pages .case-gallery-item,
	.case-gallery-numbered .case-gallery-item { margin-bottom: clamp(1.2rem,2vw,2rem); }
	.case-gallery-pages .case-gallery-trigger,
	.case-gallery-numbered .case-gallery-trigger { background: #fff; box-shadow: 0 .8rem 2rem rgba(0,0,0,.05); }
	.case-gallery-numbered figcaption { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: start; gap: clamp(.4rem,1vw,1rem); }
	.case-gallery-numbered figcaption span { min-width: 0; overflow-wrap: anywhere; }
	.case-gallery-numbered figcaption b { color: var(--color-accent); }

	@media (max-width: 900px) {
		.case-gallery-spread .case-gallery-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
		.case-gallery-pages .case-gallery-grid,
		.case-gallery-numbered .case-gallery-grid { columns: 3; }
	}

	@media (max-width: 620px) {
		.case-gallery-head { grid-template-columns: minmax(0,1fr); gap: 1.4rem; margin-bottom: 2.5rem; }
		.case-gallery h2 { overflow-wrap: anywhere; }
		.case-gallery-description { overflow-wrap: anywhere; }
		.case-gallery-spread .case-gallery-grid { gap: .65rem; }
		.case-gallery-spread .case-gallery-trigger { padding: .25rem; }
		.case-gallery-pages .case-gallery-grid,
		.case-gallery-numbered .case-gallery-grid { columns: 2; column-gap: .55rem; }
		.case-gallery-pages .case-gallery-item,
		.case-gallery-numbered .case-gallery-item { margin-bottom: .9rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.case-gallery-trigger { transition-duration: .01ms; }
	}
</style>
