---
import CaseLightbox from './CaseLightbox.astro';
---

<footer class="project-footer">
	<nav class="footer-contacts" aria-label="Контакты InDesign Studio">
		<button class="footer-copy" type="button" data-copy-value="info@indstudio.kz" data-copy-message="Почта скопирована" aria-label="Скопировать почту info@indstudio.kz">
			<span>Скопировать почту <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg></span>
			<small>info@indstudio.kz</small>
		</button>
		<button class="footer-copy" type="button" data-copy-value="+7 (708) 425 15 18" data-copy-message="Номер скопирован" aria-label="Скопировать номер +7 (708) 425 15 18">
			<span>Скопировать номер <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg></span>
			<small>+7 (708) 425 15 18</small>
		</button>
		<a class="footer-call" href="tel:+77084251518">Позвонить →</a>
		<a href="https://www.instagram.com/indesign_studio/" target="_blank" rel="noopener noreferrer">Instagram ↗&#xfe0e;</a>
		<a href="https://api.whatsapp.com/send/?phone=77084251518&amp;text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%21%0A%0A%D0%9F%D0%B8%D1%88%D1%83+%D0%BF%D0%BE+%D0%BF%D0%BE%D0%B2%D0%BE%D0%B4%D1%83+%D1%80%D0%B0%D0%B7%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D0%BA%D0%B8+%D0%BC%D0%BD%D0%BE%D0%B3%D0%BE%D1%81%D1%82%D1%80%D0%B0%D0%BD%D0%B8%D1%87%D0%BD%D0%BE%D0%B3%D0%BE+%D0%B8%D0%B7%D0%B4%D0%B0%D0%BD%D0%B8%D1%8F.%0A%0A&amp;type=phone_number&amp;app_absent=0" target="_blank" rel="noopener noreferrer">WhatsApp ↗&#xfe0e;</a>
	</nav>
	<a class="footer-home" href="/"><strong>Вернуться на главную <i aria-hidden="true">↗&#xfe0e;</i></strong></a>
</footer>

<CaseLightbox id="case-image-lightbox" variant="single" label="Увеличенное изображение проекта" />

<script>
	document.querySelectorAll<HTMLImageElement>('main img').forEach((image) => {
		if (image.closest('button, a, dialog, [data-no-zoom]') || image.classList.contains('case-image-zoomable')) return;
		image.classList.add('case-image-zoomable');
		image.dataset.lightboxTarget = 'case-image-lightbox';
		image.dataset.caption = image.alt;
		image.tabIndex = 0;
		image.setAttribute('role', 'button');
		image.setAttribute('aria-label', image.alt ? `Увеличить: ${image.alt}` : 'Увеличить изображение');
		image.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			image.click();
		});
	});
</script>

<style>
	.project-footer {
		width: 100%;
		max-width: 88rem;
		min-height: clamp(10rem, 17vw, 16rem);
		margin: clamp(8rem, 13vw, 13rem) auto 0;
		padding: clamp(2rem, 4vw, 4rem) 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		border-top: 1px solid rgba(17,17,17,.12);
		color: #111;
	}

	.footer-contacts {
		display: grid;
		grid-template-columns: repeat(2, max-content);
		gap: 1.15rem clamp(1.5rem, 3vw, 3rem);
	}

	.footer-contacts a,
	.footer-contacts button {
		padding: 0;
		color: #111;
		background: transparent;
		border: 0;
		font: inherit;
		font-size: .68rem;
		font-weight: 750;
		line-height: 1.3;
		text-align: left;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
	}

	.footer-copy { display:grid; gap:.3rem; }
	.footer-copy span { display:flex; align-items:center; gap:.35rem; }
	.footer-copy small { color:#777; font-size:.62rem; font-weight:600; }
	.footer-copy svg { width:.9rem; height:.9rem; fill:none; stroke:currentColor; stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
	.footer-call { display:none; }

	.footer-contacts a:hover,
	.footer-contacts button:hover { color: var(--color-accent); }

	.footer-home { flex: 0 1 auto; color: inherit; text-decoration: none; }

	.footer-home strong {
		display: flex;
		align-items: center;
		gap: .18em;
		font-size: var(--text-display-subsection);
		line-height: .95;
		letter-spacing: -.055em;
		text-align: right;
	}

	.footer-home i {
		flex: 0 0 auto;
		display: inline-grid;
		width: 1em;
		height: 1em;
		place-items: center;
		color: #fff;
		background: var(--color-accent);
		border-radius: 50%;
		font-size: .55em;
		font-style: normal;
		transition: transform .2s ease;
	}

	.footer-home:hover i { transform: translate(.15rem, -.15rem); }

	:global(main img.case-image-zoomable) { cursor: zoom-in; }
	:global(main img.case-image-zoomable:focus-visible) { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	.footer-home:focus-visible,
	.footer-contacts a:focus-visible,
	.footer-contacts button:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 700px) {
		.project-footer {
			min-height: 10rem;
			margin-top: 7rem;
			padding-block: 2.5rem;
			align-items: flex-start;
			flex-direction: column;
		}

		.footer-contacts {
			width: 100%;
			grid-template-columns: repeat(2, minmax(0,1fr));
			gap: 1rem;
		}

		.footer-contacts a,
		.footer-contacts button { font-size:.75rem; line-height:1.45; white-space: normal; }
		.footer-copy small { font-size:.7rem; line-height:1.4; }
		.footer-call { display:block; }

		.footer-home strong {
			max-width: 18rem;
			font-size: clamp(2rem, 10vw, 3rem);
			text-align: left;
		}

		.footer-home i {
			flex-basis: 2.25rem;
			width: 2.25rem;
			height: 2.25rem;
			font-size: .82rem;
			line-height: 1;
			overflow: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-home i { transition-duration: .01ms; }
	}
</style>
