---
import BackToTop from './BackToTop.astro';
import ProjectFooter from './ProjectFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
	categoryIndex: string;
	titleTop: string;
	titleAccent: string;
	description: string;
	projectType: string;
	projectTitle: string;
	projectDescription: string;
	projectHref: string;
	visualTop: string;
	visualAccent: string;
	projectTwoTitle?: string;
	projectTwoHref?: string;
	projectTwoImages?: string[];
	projectThreeTitle?: string;
	projectThreeHref?: string;
	projectThreeImages?: string[];
	placeholderDescription?: string;
	projectImages?: string[];
}

const {
	categoryIndex,
	titleTop,
	titleAccent,
	description,
	projectType,
	projectTitle,
	projectDescription,
	projectHref,
	visualTop,
	visualAccent,
	projectTwoTitle = 'Название проекта',
	projectTwoHref,
	projectTwoImages,
	projectThreeTitle = 'Название проекта',
	projectThreeHref,
	projectThreeImages,
	placeholderDescription = 'Короткое описание проекта',
	projectImages,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={`${titleTop} ${titleAccent} — каталог проектов InDesign Studio.`} />
		<meta name="theme-color" content="#ffffff" />
		<title>{titleTop} {titleAccent} — InDesign Studio</title>
	</head>
	<body id="top">
		<SiteHeader />

		<main>
			<section class="catalog-head">
				<p class="eyebrow">Портфолио</p>
				<div class="title-row">
					<h1 class:list={{ 'title-long': titleTop.length > 14 }}>
						<span class="title-top">{titleTop}</span>
						<span class="title-accent">{titleAccent}</span>
					</h1>
					<div class="intro">
						<p>{description}</p>
					</div>
				</div>
			</section>

			<section class="projects" aria-label="Каталог проектов">
				<a class="project project-featured" href={projectHref}>
					<div class="project-top"><span>01 / {projectType}</span><b aria-hidden="true">↗&#xfe0e;</b></div>
					{projectImages?.length === 3 ? (
						<div class="project-visual real-covers" aria-hidden="true">
							{projectImages.map((src, index) => <img src={src} alt="" loading={index === 1 ? 'eager' : 'lazy'} />)}
						</div>
					) : (
						<div class="project-visual" aria-hidden="true">
							<div class="spread spread-back"></div>
							<div class="spread spread-front">
								<div class="spread-page page-left"><small>INDESIGN STUDIO</small><strong>{visualTop}<br /><em>{visualAccent}</em></strong><span>2026</span></div>
								<div class="spread-page page-right"><i></i><i></i><i></i><p>Структура<br />Типографика<br />Вёрстка</p></div>
							</div>
						</div>
					)}
					<div class="project-bottom">
						<div><h2>{projectTitle}</h2><p>{projectDescription}</p></div>
						<span>Открыть</span>
					</div>
				</a>

				{projectTwoHref ? (
					<a class="project project-empty project-linked" href={projectTwoHref} style="color:#fff;background:#0b0b0b;border-color:#ffffff22">
						<div class="project-top"><span>02 / {projectTwoTitle}</span><b aria-hidden="true" style="border-color:#ffffff44">↗&#xfe0e;</b></div>
						<div class="cover-preview" aria-hidden="true">
							{projectTwoImages?.map((src) => <img src={src} alt="" loading="lazy" />)}
						</div>
						<div class="project-bottom"><div><h2>{projectTwoTitle}</h2><p>{placeholderDescription}</p></div><span>Открыть</span></div>
					</a>
				) : (
					<article class="project project-empty">
						<div class="project-top"><span>02 / {projectTwoTitle}</span></div>
						<div class="empty-visual" aria-hidden="true"><div><span>+</span><small>Место для обложки</small></div></div>
						<div class="project-bottom"><div><h2>{projectTwoTitle}</h2><p>{placeholderDescription}</p></div><span>Скоро</span></div>
					</article>
				)}

				{projectThreeHref ? (
					<a class="project project-empty project-linked" href={projectThreeHref} style="color:#fff;background:#0b0b0b;border-color:#ffffff22">
						<div class="project-top"><span>03 / {projectThreeTitle}</span><b aria-hidden="true" style="border-color:#ffffff44">↗&#xfe0e;</b></div>
						<div class="cover-preview" aria-hidden="true" style="min-height:22rem;position:relative;display:grid;place-items:center;overflow:hidden;isolation:isolate">
							{projectThreeImages?.map((src, index) => <img src={src} alt="" loading="lazy" width="190" height="270" style={`width:${index === 1 ? '12rem' : '10rem'};height:auto;position:absolute;left:50%;top:50%;z-index:${index === 1 ? 3 : index === 0 ? 1 : 2};transform:${index === 0 ? 'translate(-108%,-45%) rotate(-8deg)' : index === 1 ? 'translate(-50%,-52%)' : 'translate(8%,-45%) rotate(8deg)'}`} />)}
						</div>
						<div class="project-bottom"><div><h2>{projectThreeTitle}</h2><p>{placeholderDescription}</p></div><span>Открыть</span></div>
					</a>
				) : (
					<article class="project project-empty">
						<div class="project-top"><span>03 / {projectThreeTitle}</span></div>
						<div class="empty-visual" aria-hidden="true"><div><span>+</span><small>Место для обложки</small></div></div>
						<div class="project-bottom"><div><h2>{projectThreeTitle}</h2><p>{placeholderDescription}</p></div><span>Скоро</span></div>
					</article>
				)}
			</section>

			<ProjectFooter />
		</main>
		<BackToTop />
	</body>
</html>

<style>
	:root { font-family: Inter,"Segoe UI",Arial,sans-serif; color: #111; background: #fff; font-synthesis: none; }
	* { box-sizing: border-box; }
	body { margin: 0; min-width: 0; overflow-x: clip; }
	a { color: inherit; }
	header { height: 6rem; padding: 0 clamp(1.25rem,4vw,4.5rem); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
	.back { display: flex; align-items: center; gap: .7rem; width: max-content; font-size: .72rem; font-weight: 750; text-decoration: none; }
	.back span { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border: 1px solid #1113; border-radius: 50%; transition: transform .2s ease; }
	.back:hover span { transform: translateX(-.25rem); }
	.brand { display: block; width: clamp(7.8rem,10vw,10rem); line-height: 0; }
	.brand img { display: block; width: 100%; height: auto; }
	.page-count { justify-self: end; color: #777; font-size: .62rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
	main { padding: 0 clamp(1.25rem,4vw,4.5rem) clamp(2rem,5vw,5rem); }
	.catalog-head { padding: clamp(3rem,7vw,7rem) 0 clamp(4rem,8vw,8rem); }
	.eyebrow { margin: 0 0 2rem; color: var(--color-accent); font-size: .64rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.title-row { display: grid; grid-template-columns: 1fr minmax(19rem,.35fr); gap: 4rem; align-items: end; }
	.title-row > *,.project-bottom > div { min-width: 0; }
	h1 { margin: 0; font-size: var(--text-display-md); line-height: .79; letter-spacing: -.08em; }
	h1 .title-top { display:block; }
	h1 .title-accent { display:block; color:var(--color-accent); font-family:inherit; font-size:.82em; font-style:normal; font-weight:inherit; line-height:inherit; letter-spacing:-.055em; }
	.intro p { margin: 0; color: #666; font-size: clamp(1rem,1.2vw,1.14rem); line-height: 1.7; }
	.projects { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1rem,2vw,2rem); }
	.project { min-height: clamp(34rem,38vw,44rem); padding: clamp(1.3rem,2vw,2rem); display: grid; grid-template-rows: auto 1fr auto; border-radius: var(--radius-card); overflow: hidden; position: relative; }
	.project-featured { color: #fff; background: #0b0b0b; text-decoration: none; transition: transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease; }
	.project-featured:hover { transform: translateY(-.35rem); box-shadow: 0 2rem 5rem #0003; }
	.project-empty { background: #f4f4f1; border: 1px solid #1112; }
	.project-linked { color:#fff; background:#0b0b0b; border-color:#fff2; text-decoration:none; transition:transform .3s ease,box-shadow .3s ease; }
	.project-linked:hover { transform:translateY(-.3rem); box-shadow:0 1.5rem 4rem #0002; }
	.project-linked .project-top b { width:2.8rem; aspect-ratio:1; display:grid; place-items:center; border:1px solid #fff4; border-radius:50%; transition:transform .25s ease,background .25s ease,color .25s ease; }
	.project-linked:hover .project-top b { color:#fff; background:var(--color-accent); transform:rotate(45deg); }
	.project-top,.project-bottom { z-index: 3; display: flex; justify-content: space-between; gap: 1rem; position: relative; }
	.project-top > span { opacity: .55; font-size: .57rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.project-top b { width: 2.8rem; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid #fff4; border-radius: 50%; transition: transform .25s ease,background .25s ease; }
	.project-featured:hover .project-top b { transform: rotate(45deg); background: var(--color-accent); }
	.project-visual { display: grid; place-items: center; position: relative; min-height: 22rem; }
	.project-visual::before { content: ""; position: absolute; width: min(85%,24rem); aspect-ratio: 1; border: 1px solid #fff2; border-radius: 50%; }
	.real-covers { display: flex; align-items: center; justify-content: center; gap: clamp(.7rem,2vw,2rem); isolation: isolate; }
	.real-covers img { position: relative; z-index: 2; width: clamp(7.5rem,24%,10rem); height: auto; border-radius: var(--radius-thumb); box-shadow: 0 2rem 4rem #000a; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
	.real-covers img:first-child { transform: rotate(-7deg) translateY(4%); }
	.real-covers img:nth-child(2) { width: clamp(9rem,29%,12rem); z-index: 3; transform: translateY(-2%); }
	.real-covers img:last-child { transform: rotate(7deg) translateY(4%); }
	.project-featured:hover .real-covers img:first-child { transform: rotate(-3deg) translateY(0); }
	.project-featured:hover .real-covers img:nth-child(2) { transform: translateY(-4%) scale(1.025); }
	.project-featured:hover .real-covers img:last-child { transform: rotate(3deg) translateY(0); }
	.spread { position: absolute; width: min(70%,60rem); aspect-ratio: 1.55; border-radius: var(--radius-thumb); }
	.spread-back { background: var(--color-accent); transform: rotate(7deg); opacity: .7; }
	.spread-front { display: grid; grid-template-columns: 1fr 1fr; color: #111; background: #fff; box-shadow: 0 2rem 5rem #0008; transform: rotate(-3deg); transition: transform .5s cubic-bezier(.2,.8,.2,1); overflow: hidden; }
	.project-featured:hover .spread-front { transform: rotate(0deg) scale(1.025); }
	.spread-page { padding: 8%; position: relative; }
	.page-left { border-right: 1px solid #1112; }
	.page-left small { font-size: clamp(.3rem,.55vw,.6rem); letter-spacing: .15em; }
	.page-left strong { display: block; margin-top: 23%; font-family: Georgia,serif; font-size: clamp(1.7rem,4vw,4.7rem); line-height: .82; font-weight: 400; letter-spacing: -.055em; }
	.page-left em { color: var(--color-accent); font-weight: 400; }
	.page-left > span { position: absolute; left: 8%; bottom: 8%; font-size: .5rem; font-weight: 800; }
	.page-right { display: flex; align-items: end; gap: .35rem; background: #f3f3f0; }
	.page-right i { width: 1.2rem; background: #111; }
	.page-right i:nth-child(1) { height: 24%; }
	.page-right i:nth-child(2) { height: 43%; background: var(--color-accent); }
	.page-right i:nth-child(3) { height: 32%; }
	.page-right p { margin: 0 0 0 auto; font-size: clamp(.35rem,.65vw,.65rem); line-height: 1.6; }
	.project-bottom { align-items: end; }
	.project-bottom h2 { margin: 0; font-size: clamp(1.7rem,3vw,3rem); line-height: .95; letter-spacing: -.05em; }
	.project-bottom p { margin: .65rem 0 0; opacity: .55; font-size: .68rem; }
	.project-bottom > span { font-size: .58rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.empty-visual { display: grid; place-items: center; min-height: 22rem; }
	.empty-visual > div { width: 68%; aspect-ratio: 4/3; display: grid; place-items: center; align-content: center; gap: 1rem; color: #888; border: 1px dashed #1114; border-radius: var(--radius-thumb); }
	.empty-visual span { width: 2.5rem; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid #1113; border-radius: 50%; font-size: 1.2rem; }
	.empty-visual small { font-size: .6rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
	.cover-preview { min-height:22rem; position:relative; display:grid; place-items:center; overflow:hidden; isolation:isolate; }
	.cover-preview::before { content:""; position:absolute; width:min(85%,24rem); aspect-ratio:1; border:1px solid #fff2; border-radius:50%; }
	.cover-preview img { width:clamp(7.5rem,24%,10rem); height:auto; position:absolute; left:50%; top:50%; object-fit:contain; display:block; border-radius:var(--radius-thumb); box-shadow:0 1.5rem 3rem #000c; transition:transform .4s cubic-bezier(.2,.8,.2,1); }
	.cover-preview img:first-child { z-index:1; transform:translate(-108%,-45%) rotate(-8deg); }
	.cover-preview img:nth-child(2) { z-index:3; width:clamp(9rem,29%,12rem); transform:translate(-50%,-52%); }
	.cover-preview img:last-child { z-index:2; transform:translate(8%,-45%) rotate(8deg); }
	.project-linked:hover .cover-preview img:first-child { transform:translate(-112%,-48%) rotate(-4deg); }
	.project-linked:hover .cover-preview img:nth-child(2) { transform:translate(-50%,-56%) scale(1.025); }
	.project-linked:hover .cover-preview img:last-child { transform:translate(12%,-48%) rotate(4deg); }
	@media (max-width:980px) {
		.projects { grid-template-columns: 1fr; }
	}
	@media (max-width:760px) {
		header { height: 4.75rem; padding: 0 1rem; grid-template-columns: 1fr; }
		.brand,.page-count { display: none; }
		main { padding-inline: 1rem; }
		.catalog-head { padding: 3rem 0 4rem; }
		.eyebrow { margin-bottom: 1.5rem; font-size: .7rem; line-height: 1.5; letter-spacing: .1em; }
		.title-row,.projects { grid-template-columns: 1fr; gap: 2rem; }
		h1 { max-width: 100%; line-height: .84; letter-spacing: -.065em; hyphens: none; overflow-wrap: normal; word-break: normal; }
		h1.title-long .title-top { white-space: normal; hyphens: auto; overflow-wrap: anywhere; }
		.intro p { font-size: 1rem; overflow-wrap: anywhere; }
		.intro span { font-size: .68rem; line-height: 1.45; }
		.project { min-height: 27rem; padding: 1.25rem; }
		.project-featured { min-height: 27rem; }
		.project-visual { min-height: 18rem; }
		.project-empty .empty-visual { min-height: 17rem; }
		.cover-preview { min-height:17rem; }
		.project-top > span { font-size: .65rem; line-height: 1.5; }
		.project-bottom { align-items: flex-end; }
		.project-bottom p { font-size: .72rem; line-height: 1.5; overflow-wrap: anywhere; }
		.project-bottom > span { flex: 0 0 auto; font-size: .64rem; line-height: 1.4; }
		.real-covers { gap: .45rem; }
		.real-covers img { width: 27%; min-width: 0; }
		.real-covers img:nth-child(2) { width: 38%; }
		.spread { width: 88%; }
	}
	@media (prefers-reduced-motion:reduce) { * { transition-duration:.01ms !important; } }
	:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
</style>
