---
import '../styles/tokens.css';
import logoUrl from '../../indesign logo.svg?url';

const whatsappUrl = 'https://api.whatsapp.com/send/?phone=77084251518&text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%21%0A%0A%D0%9F%D0%B8%D1%88%D1%83+%D0%BF%D0%BE+%D0%BF%D0%BE%D0%B2%D0%BE%D0%B4%D1%83+%D1%80%D0%B0%D0%B7%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D0%BA%D0%B8+%D0%BC%D0%BD%D0%BE%D0%B3%D0%BE%D1%81%D1%82%D1%80%D0%B0%D0%BD%D0%B8%D1%87%D0%BD%D0%BE%D0%B3%D0%BE+%D0%B8%D0%B7%D0%B4%D0%B0%D0%BD%D0%B8%D1%8F.%0A%0A&type=phone_number&app_absent=0';
---

<div class="site-header">
	<nav class="site-header-inner" aria-label="Контакты InDesign Studio">
		<a class="site-brand" href="/" aria-label="InDesign Studio — на главную">
			<img src={logoUrl} alt="InDesign Studio" />
		</a>

		<div class="site-nav-links">
			<button type="button" data-copy-value="info@indstudio.kz" data-copy-message="Почта скопирована" aria-label="Скопировать почту info@indstudio.kz">
				<span>Скопировать почту</span>
				<svg class="copy-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg>
			</button>
			<button type="button" data-copy-value="+7 (708) 425 15 18" data-copy-message="Номер скопирован" aria-label="Скопировать номер +7 (708) 425 15 18">
				<span>Скопировать номер</span>
				<svg class="copy-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg>
			</button>
			<a href="https://www.instagram.com/indesign_studio/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
			<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
		</div>

		<a class="site-status" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
			<span aria-hidden="true"></span>Принимаем новые проекты
		</a>

		<div class="mobile-nav">
			<a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
			<button class="mobile-contacts-toggle" type="button" aria-expanded="false" aria-controls="mobile-contact-panel">
				Контакты <span aria-hidden="true">+</span>
			</button>
		</div>

		<div class="mobile-contact-panel" id="mobile-contact-panel" hidden>
			<button type="button" data-copy-value="info@indstudio.kz" data-copy-message="Почта скопирована" aria-label="Скопировать почту info@indstudio.kz">
				<span>Скопировать почту</span>
				<strong>info@indstudio.kz</strong>
				<svg class="copy-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg>
			</button>
			<a href="tel:+77084251518">
				<span>Позвонить</span>
				<strong>+7 (708) 425 15 18</strong>
				<i aria-hidden="true">→</i>
			</a>
			<button type="button" data-copy-value="+7 (708) 425 15 18" data-copy-message="Номер скопирован" aria-label="Скопировать номер +7 (708) 425 15 18">
				<span>Скопировать номер</span>
				<strong>+7 (708) 425 15 18</strong>
				<svg class="copy-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="2.5" width="8" height="8" rx="1"></rect><path d="M10.5 10.5v2a1 1 0 0 1-1 1h-7v-8a1 1 0 0 1 1-1h2"></path></svg>
			</button>
			<a href="https://www.instagram.com/indesign_studio/" target="_blank" rel="noopener noreferrer">
				<span>Instagram</span>
				<strong>@indesign_studio ↗</strong>
				<i aria-hidden="true">↗</i>
			</a>
		</div>
	</nav>
</div>

<div class="copy-toast" role="status" aria-live="polite" aria-atomic="true" hidden></div>

<script>
	const copyToast = document.querySelector<HTMLElement>('.copy-toast');
	let copyToastTimer = 0;

	document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copyValue ?? '');
				if (!copyToast) return;
				copyToast.textContent = button.dataset.copyMessage ?? 'Скопировано';
				copyToast.hidden = false;
				window.clearTimeout(copyToastTimer);
				copyToastTimer = window.setTimeout(() => { copyToast.hidden = true; }, 3000);
			} catch {
				if (!copyToast) return;
				copyToast.textContent = 'Не удалось скопировать';
				copyToast.hidden = false;
			}
		});
	});

	const contactToggle = document.querySelector<HTMLButtonElement>('.mobile-contacts-toggle');
	const contactPanel = document.querySelector<HTMLElement>('#mobile-contact-panel');

	const setContactPanel = (open: boolean) => {
		if (!contactToggle || !contactPanel) return;
		contactToggle.setAttribute('aria-expanded', String(open));
		contactToggle.querySelector('span')!.textContent = open ? '×' : '+';
		contactPanel.hidden = !open;
	};

	contactToggle?.addEventListener('click', () => {
		setContactPanel(contactToggle.getAttribute('aria-expanded') !== 'true');
	});

	document.addEventListener('click', (event) => {
		if (contactPanel?.hidden || (event.target instanceof Node && document.querySelector('.site-header')?.contains(event.target))) return;
		setContactPanel(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || contactPanel?.hidden) return;
		setContactPanel(false);
		contactToggle?.focus();
	});

	const shortWordPattern = /(^|[\s([{"«„—–])(из-за|из-под|без|для|вне|над|обо|под|при|про|во|до|за|из|ко|на|не|ни|но|об|от|по|со|а|в|и|к|о|с|у) (?=[А-ЯЁа-яё0-9«„])/gi;
	const bindTextNode = (textNode: Node) => {
		if (textNode.parentElement?.closest('script, style, pre, code')) return;
		let formatted = textNode.nodeValue ?? '';
		let previous = '';
		do {
			previous = formatted;
			formatted = formatted.replace(shortWordPattern, '$1$2\u00a0');
		} while (formatted !== previous);
		if (formatted !== textNode.nodeValue) textNode.nodeValue = formatted;
	};
	const bindShortWords = (root: Node) => {
		if (root.nodeType === Node.TEXT_NODE) return bindTextNode(root);
		const textNodes = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
		let textNode: Node | null;
		while ((textNode = textNodes.nextNode())) bindTextNode(textNode);
	};

	// ponytail: клиентский проход не требует размечать каждый текст; для no-JS понадобится сборочный HTML-трансформер.
	bindShortWords(document.body);
	new MutationObserver((mutations) => {
		for (const mutation of mutations) {
			if (mutation.type === 'characterData') bindTextNode(mutation.target);
			else mutation.addedNodes.forEach(bindShortWords);
		}
	}).observe(document.body, { childList: true, characterData: true, subtree: true });
</script>

<style>
	.site-header,
	.site-header * { box-sizing: border-box; }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		min-height: 6rem;
		padding: 1.25rem clamp(1.25rem,4vw,4.5rem);
		display: grid;
		align-items: center;
		color: #111;
		background: rgba(255,255,255,.94);
		border-bottom: 1px solid rgba(17,17,17,.08);
		backdrop-filter: blur(16px);
	}

	.site-header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
	.site-brand { display: block; width: clamp(7.8rem,10vw,10rem); line-height: 0; }
	.site-brand img { display: block; width: 100%; height: auto; }
	.site-nav-links { display: flex; align-items: center; gap: clamp(1.25rem,3vw,3.2rem); }
	.site-nav-links a,.site-nav-links button,.site-status { color: inherit; font: inherit; font-size: .78rem; font-weight: 650; letter-spacing: .03em; text-decoration: none; }
	.site-nav-links a,.site-nav-links button { position: relative; white-space: nowrap; }
	.site-nav-links button { padding: 0; display:inline-flex; align-items:center; gap:.35rem; background: none; border: 0; cursor: pointer; }
	.copy-icon { width:1rem; height:1rem; flex:0 0 auto; fill:none; stroke:currentColor; stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
	.site-nav-links a::after,.site-nav-links button::after { content: ""; position: absolute; left: 0; bottom: -.35rem; width: 100%; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform .25s ease; }
	.site-nav-links a:hover::after,.site-nav-links a:focus-visible::after,.site-nav-links button:hover::after,.site-nav-links button:focus-visible::after { transform: scaleX(1); transform-origin: left; }
	.site-status { justify-self: end; display: flex; align-items: center; gap: .55rem; white-space: nowrap; }
	.site-status > span { width: .45rem; height: .45rem; flex: 0 0 auto; background: var(--color-accent); border-radius: 50%; box-shadow: 0 0 0 .3rem rgba(201,36,39,.12); }
	.mobile-nav,.mobile-contact-panel { display: none; }
	.site-brand:focus-visible,.site-nav-links a:focus-visible,.site-nav-links button:focus-visible,.site-status:focus-visible,.mobile-nav a:focus-visible,.mobile-nav button:focus-visible,.mobile-contact-panel a:focus-visible,.mobile-contact-panel button:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	.copy-toast { position:fixed; top:7rem; right:clamp(1rem,4vw,4.5rem); z-index:300; padding:.85rem 1rem; color:#fff; background:#111; border-radius:var(--radius-thumb); box-shadow:0 .8rem 2rem rgba(0,0,0,.2); font-size:.82rem; font-weight:750; }
	.copy-toast[hidden] { display:none; }

	@media (max-width: 900px) {
		.site-header { min-height: 4.75rem; padding: .75rem 1rem; }
		.site-header-inner { position: relative; grid-template-columns: auto 1fr; gap: .75rem; }
		.site-brand { width: 5rem; }
		.site-nav-links,.site-status { display: none; }
		.mobile-nav { min-width: 0; display: flex; justify-content: flex-end; gap: .45rem; }
		.mobile-nav a,.mobile-nav button {
			min-height: 2.75rem;
			padding: .72rem .85rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			color: #111;
			background: #fff;
			border: 1px solid rgba(17,17,17,.18);
			border-radius: var(--radius-pill);
			font: inherit;
			font-size: .78rem;
			font-weight: 750;
			line-height: 1;
			text-decoration: none;
			white-space: nowrap;
			cursor: pointer;
		}
		.mobile-nav .mobile-whatsapp { color: #fff; background: #111; border-color: #111; }
		.mobile-contacts-toggle { gap: .5rem; }
		.mobile-contacts-toggle span { color: var(--color-accent); font-size: 1.05rem; font-weight: 500; line-height: .7; }
		.mobile-contact-panel {
			position: absolute;
			top: calc(100% + 1rem);
			left: 0;
			right: 0;
			padding: .45rem;
			color: #fff;
			background: #111;
			border: 1px solid rgba(255,255,255,.14);
			border-radius: var(--radius-card);
			box-shadow: 0 1rem 2.5rem rgba(0,0,0,.22);
		}
		.mobile-contact-panel:not([hidden]) { display: grid; }
		.mobile-contact-panel a,.mobile-contact-panel button {
			width: 100%;
			min-height: 3.6rem;
			padding: .85rem 1rem;
			display: grid;
			grid-template-columns: 8.5rem minmax(0,1fr) 1.25rem;
			align-items: center;
			gap: .75rem;
			color: inherit;
			background: transparent;
			border: 0;
			border-bottom: 1px solid rgba(255,255,255,.14);
			font: inherit;
			text-align: left;
			text-decoration: none;
			cursor: pointer;
		}
		.mobile-contact-panel > :last-child { border-bottom: 0; }
		.mobile-contact-panel span { color: #999; font-size: .72rem; font-weight: 650; }
		.mobile-contact-panel strong { min-width: 0; overflow-wrap: anywhere; font-size: .85rem; line-height: 1.25; }
		.mobile-contact-panel i { justify-self:end; color:#fff; font-style:normal; }
		.mobile-contact-panel .copy-icon { justify-self:end; }
		.copy-toast { top:5.5rem; left:1rem; right:1rem; text-align:center; }
	}

	@media (max-width: 380px) {
		.site-header { padding-inline: .75rem; }
		.site-header-inner { gap: .5rem; }
		.site-brand { width: 4.5rem; }
		.mobile-nav { gap: .35rem; }
		.mobile-nav a,.mobile-nav button { padding-inline: .7rem; font-size: .75rem; }
		.mobile-contact-panel a,.mobile-contact-panel button { grid-template-columns:1fr 1.3rem; gap:.35rem .75rem; }
		.mobile-contact-panel span { grid-column:1; }
		.mobile-contact-panel strong { grid-column:1; }
		.mobile-contact-panel i,.mobile-contact-panel .copy-icon { grid-column:2; grid-row:1 / span 2; }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav-links a::after,.site-nav-links button::after { transition-duration: .01ms; }
	}
</style>
