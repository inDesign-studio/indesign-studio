---
interface Props {
	subject: string;
}

const { subject } = Astro.props;
const message = `Здравствуйте!\n\nХочу обсудить ${subject}.`;
const whatsappUrl = `https://api.whatsapp.com/send/?phone=77084251518&text=${encodeURIComponent(message)}&type=phone_number&app_absent=0`;
---

<aside class="project-cta" aria-label="Обсудить похожий проект">
	<div class="project-cta-title">
		<span>Похожая задача?</span>
		<strong>Обсудить похожий проект</strong>
	</div>
	<p>Для предварительной оценки достаточно указать формат, примерный объём, доступные материалы и желаемый срок.</p>
	<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
		Написать в WhatsApp <span aria-hidden="true">↗&#xfe0e;</span>
	</a>
</aside>

<style>
	.project-cta {
		box-sizing: border-box;
		width: min(100%,82rem);
		margin: 0 auto clamp(6rem,10vw,10rem);
		padding: clamp(1.2rem,2vw,1.7rem);
		display: grid;
		grid-template-columns: minmax(14rem,.8fr) minmax(19rem,1fr) auto;
		align-items: center;
		gap: clamp(1.25rem,3vw,3rem);
		color: #fff;
		background: #111;
		border-radius: var(--radius-card);
	}

	.project-cta-title { display: grid; gap: .35rem; }
	.project-cta-title span { color: var(--color-accent); font-size: .6rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	.project-cta-title strong { font-size: clamp(1.15rem,1.6vw,1.55rem); line-height: 1.05; letter-spacing: -.035em; }
	.project-cta p { max-width: 34rem; margin: 0; color: #b9b9b9; font-size: .86rem; line-height: 1.55; }
	.project-cta a {
		min-height: 3.2rem;
		padding: .8rem 1rem .8rem 1.2rem;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: #fff;
		background: var(--color-accent);
		border-radius: var(--radius-pill);
		font-size: .72rem;
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
		transition: background .2s ease,transform .2s ease,box-shadow .2s ease;
	}
	.project-cta a span { width: 1.8rem; height: 1.8rem; display: grid; place-items: center; color: var(--color-accent); background: #fff; border-radius: 50%; font-size: .9rem; }
	.project-cta a:hover { transform: translateY(var(--cta-hover-lift)); box-shadow: var(--cta-hover-shadow); }
	.project-cta a:active { transform: translateY(var(--cta-active-lift)); box-shadow: none; }
	.project-cta a:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 820px) {
		.project-cta { grid-template-columns: 1fr auto; }
		.project-cta p { grid-column: 1; }
		.project-cta a { grid-column: 2; grid-row: 1 / span 2; }
	}

	@media (max-width: 620px) {
		.project-cta {
			margin-bottom: 6rem;
			padding: 1.25rem;
			grid-template-columns: 1fr;
			gap: 1rem;
			border-radius: var(--radius-card);
		}
		.project-cta p,.project-cta a { grid-column: 1; grid-row: auto; }
		.project-cta-title span { font-size: .7rem; line-height: 1.45; }
		.project-cta a { width: 100%; min-height: 3.4rem; box-sizing: border-box; font-size: .78rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.project-cta a { transition-duration: .01ms; }
	}
</style>
