<a class="back-to-top" href="#top" aria-label="Вернуться в начало страницы" aria-hidden="true" tabindex="-1">↑</a>

<script>
	const button = document.querySelector<HTMLAnchorElement>('.back-to-top');
	const footer = document.querySelector<HTMLElement>('.project-footer');
	let frame = 0;

	const updateButton = () => {
		if (!button) return;

		const isVisible = window.scrollY > window.innerHeight;
		button.classList.toggle('is-visible', isVisible);
		button.setAttribute('aria-hidden', String(!isVisible));
		button.tabIndex = isVisible ? 0 : -1;

		const footerOverlap = footer
			? Math.max(0, window.innerHeight - footer.getBoundingClientRect().top)
			: 0;
		button.style.setProperty('--footer-offset', `${footerOverlap}px`);
	};

	const scheduleUpdate = () => {
		if (frame) return;
		frame = window.requestAnimationFrame(() => {
			updateButton();
			frame = 0;
		});
	};

	updateButton();
	window.addEventListener('scroll', scheduleUpdate, { passive: true });
	window.addEventListener('resize', scheduleUpdate);
	window.addEventListener('pageshow', scheduleUpdate);
</script>

<style>
	.back-to-top {
		--footer-offset: 0px;
		position: fixed;
		right: clamp(1rem, 2.5vw, 2.5rem);
		bottom: calc(clamp(1rem, 2.5vw, 2.5rem) + env(safe-area-inset-bottom, 0px) + var(--footer-offset));
		z-index: 50;
		width: 3.5rem;
		height: 3.5rem;
		display: grid;
		place-items: center;
		color: #fff;
		background: #111;
		border: 1px solid rgba(255,255,255,.22);
		border-radius: 50%;
		box-shadow: 0 .8rem 2rem rgba(0,0,0,.2);
		font-family: Arial, sans-serif;
		font-size: 1.15rem;
		text-decoration: none;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(.75rem) scale(.92);
		transition: opacity .2s ease, visibility .2s ease, transform .25s ease, background .25s ease, bottom .2s ease;
	}

	.back-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: none;
	}

	.back-to-top.is-visible:hover { transform: translateY(var(--cta-hover-lift)); background: var(--color-accent); box-shadow: var(--cta-hover-shadow); }
	.back-to-top.is-visible:active { transform: translateY(var(--cta-active-lift)); box-shadow: none; }
	.back-to-top:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }

	@media (max-width: 620px) {
		.back-to-top {
			right: 1rem;
			width: 3rem;
			height: 3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-to-top { transition-duration: .01ms; }
	}
</style>
