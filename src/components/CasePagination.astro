---
interface Link {
	href: string;
	label: string;
}

interface Props {
	previous: Link;
	next: Link;
}

const { previous, next } = Astro.props;
---

<nav class="case-pagination" aria-label="Другие многостраничные проекты">
	<a class="case-pagination-link previous" href={previous.href}>
		<span>← Предыдущий проект</span>
		<strong>{previous.label}</strong>
	</a>
	<a class="case-pagination-link next" href={next.href}>
		<span>Следующий проект →</span>
		<strong>{next.label}</strong>
	</a>
</nav>

<style>
	.case-pagination {
		box-sizing: border-box;
		width: min(100%,88rem);
		margin: clamp(4rem,7vw,7rem) auto 0;
		display: grid;
		grid-template-columns: repeat(2,minmax(0,1fr));
		border-top: 1px solid rgba(17,17,17,.14);
		border-bottom: 1px solid rgba(17,17,17,.14);
	}
	.case-pagination-link {
		min-width: 0;
		min-height: clamp(7rem,11vw,10rem);
		padding: clamp(1.25rem,2.5vw,2.5rem);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		color: #111;
		text-decoration: none;
		transition: color .2s ease,background .2s ease;
	}
	.case-pagination-link + .case-pagination-link { border-left: 1px solid rgba(17,17,17,.14); }
	.case-pagination-link span { color: #777; font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	.case-pagination-link strong { overflow-wrap: anywhere; font-size: clamp(1.8rem,3.3vw,3.5rem); line-height: .9; letter-spacing: -.055em; }
	.case-pagination-link.next { align-items: flex-end; text-align: right; }
	.case-pagination-link:hover { color: #fff; background: #111; }
	.case-pagination-link:hover span { color: var(--color-accent); }
	.case-pagination-link:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
	:global(.case-pagination + .project-footer) { margin-top: clamp(3rem,5vw,5rem); }

	@media (max-width: 620px) {
		.case-pagination { margin-top: 4rem; grid-template-columns: 1fr; }
		.case-pagination-link { min-height: 7rem; padding: 1.25rem; }
		.case-pagination-link + .case-pagination-link { border-left: 0; border-top: 1px solid rgba(17,17,17,.14); }
		.case-pagination-link strong { font-size: 2rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.case-pagination-link { transition-duration: .01ms; }
	}
</style>
