---
type IconName =
  | 'materials'
  | 'covers'
  | 'forms'
  | 'finishing'
  | 'accessories'
  | 'cost'
  | 'ineffective'
  | 'errors'
  | 'quality'
  | 'time'
  | 'updates';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const iconClass = [className, `menu-icon--${name}`].filter(Boolean).join(' ');
---

<svg class={iconClass} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'materials' && (
    <>
      <rect x="16" y="12" width="32" height="14" rx="2" />
      <rect x="16" y="38" width="32" height="14" rx="2" />
    </>
  )}
  {name === 'covers' && (
    <>
      <path d="M32 50V20c-5-6-11-7-19-6v30c8-1 14 0 19 6Z" />
      <path d="M32 50V20c5-6 11-7 19-6v30c-8-1-14 0-19 6Z" />
    </>
  )}
  {name === 'forms' && (
    <>
      <rect x="16" y="9" width="33" height="46" rx="2" />
      <path d="M25 9v46M32 27h10M32 35h10" />
    </>
  )}
  {name === 'finishing' && (
    <g transform="matrix(.125 0 0 -.125 0 64)" stroke-width="30" stroke-linecap="butt" stroke-linejoin="miter">
      <g transform="translate(223.4922 223.4924)">
        <path d="m0 0 161.242 161.241 63.64 21.214 42.426 42.426-42.426 42.427-42.427-42.427-21.213-63.64" />
      </g>
      <g transform="translate(265.9189 181.0662)">
        <path d="m0 0c-11.716 11.716-30.711 11.716-42.427 0l-42.426-42.427c-11.715-11.715-11.715-30.71 0-42.426l-63.639-63.64c-23.432-23.431-61.422-23.431-84.854 0-23.43 23.432-23.43 61.422 0 84.853L-169.706 0c11.716-11.716 30.711-11.716 42.427 0l42.426 42.426c11.716 11.716 11.716 30.711 0 42.427" />
      </g>
      <g transform="translate(170.459 276.5254)">
        <path d="m0 0 106.066-106.066" />
      </g>
      <g transform="translate(128.0332 128.033)">
        <path d="m0 0-95.46-95.459" />
      </g>
    </g>
  )}
  {name === 'accessories' && (
    <path d="m13 18 13-7 13 7 12-5v34l-12 5-13-7-13 7V18Zm13-7v34m13-27v34" />
  )}
  {name === 'cost' && (
    <>
      <path d="M11 14h7l6 27h25l5-20H22" />
      <circle cx="28" cy="50" r="3.5" />
      <circle cx="47" cy="50" r="3.5" />
    </>
  )}
  {name === 'ineffective' && (
    <path d="m16 16 32 32M48 16 16 48" />
  )}
  {name === 'errors' && (
    <>
      <path d="m32 8 6 4 7 1 3 6 5 5-1 7 1 7-5 5-3 7-7 1-6 4-6-4-7-1-3-7-5-5 1-7-1-7 5-5 3-6 7-1 6-4Z" />
      <path d="M32 20v16m0 8h.01" />
    </>
  )}
  {name === 'quality' && (
    <>
      <path d="M32 8c7 5 14 6 21 6v17c0 12-8 20-21 25C19 51 11 43 11 31V14c7 0 14-1 21-6Z" />
      <path d="m22 32 7 7 14-16" />
    </>
  )}
  {name === 'time' && (
    <>
      <circle cx="32" cy="35" r="20" />
      <path d="M27 8h10m-5 0v7m0 20 8-8" />
    </>
  )}
  {name === 'updates' && (
    <>
      <path d="M12 27c0-8 6-14 14-14h26" />
      <path d="m46 7 6 6-6 6" />
      <path d="M52 37c0 8-6 14-14 14H12" />
      <path d="m18 45-6 6 6 6" />
    </>
  )}
</svg>
